{
  "name": "@plantops/iam-api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@plantops/iam-api"
    ],
    "tags": [
      "type:app",
      "app:iam-api-e2e"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@plantops/iam-api:build",
          "@plantops/db:migration:run"
        ],
        "options": {
          "jestConfig": "apps/iam-api-e2e/jest.config.js",
          "passWithNoTests": false
        }
      }
    }
  },
  "dependencies": {
    "@plantops/contracts": "0.0.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "eslint": "^9.8.0"
  }
}
