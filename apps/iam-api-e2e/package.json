{
  "name": "@plantops/iam-api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@plantops/iam-api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@plantops/iam-api:build",
          "@plantops/iam-api:serve"
        ],
        "options": {
          "jestConfig": "apps/iam-api-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
