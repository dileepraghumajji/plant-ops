{
  "name": "@plantops/admin-web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:app",
      "app:admin-web"
    ],
    "targets": {
      "build": {
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "apps/admin-web",
          "command": "next dev --port 4200"
        }
      },
      "start": {
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/admin-web",
          "command": "next start --port 4200"
        }
      }
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@plantops/contracts": "0.0.1",
    "@plantops/iam-client": "0.0.1",
    "@plantops/ui": "0.0.1",
    "@plantops/web-kit": "0.0.1",
    "antd": "^6.6.1",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
