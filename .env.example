# PlantOps IAM — environment template (Doc 08 §5)
#
# Copy to `.env` and fill in. Every variable below is validated at boot by
# `libs/config`; a missing or malformed value aborts startup with the list of
# problems. Real secrets come from the platform's secret store — never commit
# a filled-in `.env`.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# error | warn | log | debug | verbose
LOG_LEVEL=log

# ── Postgres (Doc 07 §2) ───────────────────────────────────────────────────
# DATABASE_URL is the *pooler* endpoint used by the app (PgBouncer transaction
# mode — TypeORM runs with prepared statements disabled against it).
# DATABASE_DIRECT_URL is the *direct*, non-pooled endpoint, used only to run
# migrations. Locally both point at the docker-compose Postgres.
DATABASE_URL=postgresql://plantops:plantops@localhost:5432/plantops_iam
DATABASE_DIRECT_URL=postgresql://plantops:plantops@localhost:5432/plantops_iam
# Managed Postgres (Supabase) needs TLS; local docker-compose does not.
DATABASE_SSL=false

# ── Redis (Doc 04 §6) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Namespaces every key this deployment writes. Give staging and production
# distinct prefixes whenever they share a managed Redis.
REDIS_KEY_PREFIX=plantops:

# ── HTTP / ops ─────────────────────────────────────────────────────────────
# Turn on ONLY behind a proxy that rewrites X-Forwarded-For (Railway, an LB).
# On without one, any caller can pick their own rate-limit bucket.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API. Empty = no CORS.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Per-dependency budget for /ready, so a hung Postgres answers 503 rather than
# hanging the readiness probe.
READINESS_TIMEOUT_MS=2000

# ── Rate limiting (429 RATE_LIMITED, Doc 06 §2) ────────────────────────────
# The blanket per-caller limit that protects the process. Credential-stuffing
# defence on /auth/* is tightened per-endpoint in code, not here.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ── JWT signing (Doc 03 §1–2) ──────────────────────────────────────────────
# RS256 keypair. Generate a dev pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# Newlines may be written literally or escaped as \n.
JWT_ISSUER=plantops-iam
JWT_SIGNING_KEY_ID=dev-key-1
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Public keys published in JWKS *alongside* the signer. JSON: { "<kid>": "<pem>" }
#
# The name says "retired", but the map carries keys at both ends of their life:
# a key published ahead of activation (rotation step 1) and a key retained after
# it stopped signing (step 4) sit here together. JWKS cannot tell them apart —
# that is what makes the ordering matter.
#
# Do not hand-edit during a rotation. `npm run keys:rotate` enforces the Doc 03
# §1 ordering and prints the next environment:
#   npm run keys:rotate -- status
#   npm run keys:rotate -- publish
#   npm run keys:rotate -- activate --kid <kid> --published-at <iso> \
#                                   --private-key-file <path>
#   npm run keys:rotate -- retire --kid <kid> --deactivated-at <iso>
JWT_RETIRED_PUBLIC_KEYS={}

# ── Token & cache lifetimes ────────────────────────────────────────────────
# Defaults come from @plantops/contracts; override only with reason.
# 15 min (Doc 03 §1)
ACCESS_TOKEN_TTL_SECONDS=900
# 7 days (Doc 03 §1)
REFRESH_TOKEN_TTL_SECONDS=604800
# ≤ 300 — the TTL *is* the service-account revocation window (Doc 03 §5)
SERVICE_TOKEN_TTL_SECONDS=300
# 10–30 — concurrent-refresh grace window (Doc 03 §4)
REFRESH_REUSE_GRACE_SECONDS=15
# ≤ 600 — safety net behind cache invalidation (Doc 04 §6)
GRANTS_CACHE_TTL_SECONDS=600

# ── Account state & password reset (Doc 03 §7–8) ───────────────────────────
# Consecutive failed logins that lock an account. The lock is administrative:
# it does not lift on its own, and it force-logs-out the account's sessions.
# There is no "off" — raise the number if you truly want no lockout.
LOGIN_MAX_FAILED_ATTEMPTS=5
# ≤ 86400 — how long a reset link stays usable. It is a bearer credential in
# somebody's inbox; the shorter this is, the less a later mailbox compromise
# is worth.
PASSWORD_RESET_TTL_SECONDS=3600

# ── Platform bootstrap (Doc 07 §8) ─────────────────────────────────────────
# Secret for the first platform identity. Minimum 32 characters, supplied
# out-of-band, and rotated immediately after first use. Never logged.
PLATFORM_BOOTSTRAP_SECRET=change-me-to-a-32-char-random-string
