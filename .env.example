# PlantOps IAM — environment template (Doc 08 §5)
#
# Copy to `.env` and fill in. Every variable below is validated at boot by
# `libs/config`; a missing or malformed value aborts startup with the list of
# problems. Real secrets come from the platform's secret store — never commit
# a filled-in `.env`.
#
# The values here are the *local* ones. Where a deployed environment needs a
# different answer, the line says so and `docs/ops-runbook.md` says why. That
# runbook is also where the deploy itself lives: role provisioning, the
# migration release step, key rotation, and what to check when paged.
#
# **This is not the file a production installation uses.** A single-tenant
# install — dedicated or self-hosted — is configured from `deploy/.env.template`,
# which documents the same variables for somebody who has never seen this
# repository, adds the ones the stack itself needs, and is filled in on the
# server rather than copied from a developer's laptop. `deploy/README.md` is the
# install guide; `libs/config` has a drift test per template so neither can go
# quietly out of date.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# error | warn | log | debug | verbose
LOG_LEVEL=log
# The build this process is, reported by GET /health (Doc 11 §8). Every image
# bakes it in from the APP_VERSION build argument and carries the same string as
# an OCI label, so "what version are you on" is answered by the process rather
# than by a dashboard nobody outside the deployment can see. Leave it alone
# locally: 0.0.0-dev is the honest answer when there is no build.
APP_VERSION=0.0.0-dev

# ── Postgres (Doc 07 §2) ───────────────────────────────────────────────────
# DATABASE_URL is the *pooler* endpoint used by the app (PgBouncer transaction
# mode — TypeORM runs with prepared statements disabled against it).
# DATABASE_DIRECT_URL is the *direct*, non-pooled endpoint, used only to run
# migrations. Locally both point at the docker-compose Postgres.
DATABASE_URL=postgresql://plantops:plantops@localhost:5432/plantops_iam
DATABASE_DIRECT_URL=postgresql://plantops:plantops@localhost:5432/plantops_iam
# Managed Postgres (Supabase) needs TLS; local docker-compose does not.
DATABASE_SSL=false
# Trust anchor for the database's TLS certificate, PEM. Required whenever the
# server's chain is not rooted in the system CA store — which is the normal case
# on managed Postgres, not the exception. Supabase's pooler serves a chain under
# its own self-signed root, so Node refuses it with SELF_SIGNED_CERT_IN_CHAIN
# unless this is set; download it from Project Settings -> Database -> SSL
# Configuration. Verification stays ON either way: there is deliberately no
# setting that encrypts the connection without authenticating the server.
# Newlines may be written literally or escaped as \n. Unset here — local
# Postgres speaks no TLS at all.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# Deployed, these two differ in *role* as well as endpoint (Doc 07 §2, §5.1):
# the app URL carries `plantops_app`, which owns nothing, and the direct URL
# carries `plantops`, which owns the schema. Pointing both at one role makes
# every RLS policy silently inert — the boot-time check in `libs/db` refuses to
# start rather than let that happen. Locally both point at the same
# docker-compose database, which is why `docs/local-testing.md` has you create
# the two roles there too.

# ── Redis (Doc 04 §6) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Namespaces every key this deployment writes. Give staging and production
# distinct prefixes whenever they share a managed Redis — without it, a staging
# deploy evicting `perms:*` invalidates production's grants cache.
REDIS_KEY_PREFIX=plantops:

# ── Deployment mode (Doc 11 §6.5) ──────────────────────────────────────────
# saas | single_tenant.
#
# `saas` is the multi-tenant platform: many organisations in one database, the
# tenant chosen at login by the slug the user types.
#
# `single_tenant` is a dedicated or self-hosted installation. One organisation,
# named below, and users type an email and a password and nothing else. The slug
# does not go away — it is still the tenant half of the credential and still
# what `app.current_client_id` is set from — the deployment supplies it instead
# of the browser. A login that supplies a *different* slug is refused, which is
# the actual control; the empty field on the form is a consequence of it.
DEPLOYMENT_MODE=saas
# Required when DEPLOYMENT_MODE=single_tenant, and refused otherwise (a value
# nothing reads is a value somebody will believe did something). Resolved to a
# client id once, at boot: the API refuses to start if no client has this slug,
# rather than coming up healthy and answering 401 to every login.
# SINGLE_TENANT_CLIENT_SLUG=

# ── HTTP / ops ─────────────────────────────────────────────────────────────
# Turn on ONLY behind a proxy that rewrites X-Forwarded-For (Railway, an LB).
# On without one, any caller can pick their own rate-limit bucket. True on the
# managed platform; false here, where nothing sits in front of the API.
#
# True in a single-tenant stack as well, and for a reason you can check rather
# than assume: `deploy/proxy/proxy-headers.conf` sets the header to $remote_addr
# — replacing whatever the caller sent instead of appending to it — so the
# address the limiter buckets on is one nginx accepted. `deploy/stack-smoke.sh`
# proves it by consequence: forged addresses all land in one bucket and get
# throttled together.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API. Empty = no CORS.
#
# A same-origin deployment needs NO entry at all: behind the bundled proxy the
# console calls the path `/api` on its own origin (Doc 11 §8), so the browser
# sends no cross-origin request and there is nothing to allow. Leaving this
# empty there is correct, not an oversight.
#
# An entry is required whenever the console is served from a different origin
# than the API. Local development is exactly that — the console holds 4200, the
# API holds PORT — and so is the managed platform, where the console is on
# Vercel and the API on Railway and this must name the console's own origin. A
# Vercel preview deployment gets a fresh hostname per deploy and will be
# refused until it is listed — that is the allow-list working, not a fault.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Per-dependency budget for /ready, so a hung Postgres answers 503 rather than
# hanging the readiness probe.
READINESS_TIMEOUT_MS=2000
# Maximum JSON body, in bytes (Doc 06 §1). 64 kB covers every route on the
# surface; the manifest upload and the bulk user upload are the two documents
# rather than forms, and each gets its own larger ceiling. Raising any of them
# is tuning for a real payload — an oversized body is refused as 400
# VALIDATION_FAILED before any handler runs.
REQUEST_BODY_LIMIT_BYTES=65536
# Serve the generated API description at GET /openapi.json. Off by default in
# every environment — turn it on where an integrating team needs it. The
# document is also a build artefact (`npm run openapi`), so a deployment does
# not have to serve it for anyone to have it.
OPENAPI_ENABLED=true
# POST /iam/applications/:id/manifest only. Must be >= REQUEST_BODY_LIMIT_BYTES.
# 4 MB sits above the largest manifest the schema will accept (~2.1 MB), so an
# upload is never refused for its size before it can be refused for its fields.
MANIFEST_BODY_LIMIT_BYTES=4194304
# POST /iam/users/bulk only. Must be >= REQUEST_BODY_LIMIT_BYTES. 1 MB sits
# above the largest 500-row upload the schema will accept (~300 kB, or about
# twice that once a CSV's line breaks are JSON-escaped), so a bulk upload is
# refused for its row count rather than for its size.
BULK_UPLOAD_BODY_LIMIT_BYTES=1048576

# ── Rate limiting (429 RATE_LIMITED, Doc 06 §2) ────────────────────────────
# The blanket per-caller limit that protects the process. Credential-stuffing
# defence on /auth/* is tightened per-endpoint in code, not here.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ── JWT signing (Doc 03 §1–2) ──────────────────────────────────────────────
# RS256 keypair. Generate a dev pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# Newlines may be written literally or escaped as \n.
JWT_ISSUER=plantops-iam
JWT_SIGNING_KEY_ID=dev-key-1
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Public keys published in JWKS *alongside* the signer. JSON: { "<kid>": "<pem>" }
#
# The name says "retired", but the map carries keys at both ends of their life:
# a key published ahead of activation (rotation step 1) and a key retained after
# it stopped signing (step 4) sit here together. JWKS cannot tell them apart —
# that is what makes the ordering matter.
#
# Do not hand-edit during a rotation. `npm run keys:rotate` enforces the Doc 03
# §1 ordering and prints the next environment:
#   npm run keys:rotate -- status
#   npm run keys:rotate -- publish
#   npm run keys:rotate -- activate --kid <kid> --published-at <iso> \
#                                   --private-key-file <path>
#   npm run keys:rotate -- retire --kid <kid> --deactivated-at <iso>
JWT_RETIRED_PUBLIC_KEYS={}

# ── Token & cache lifetimes ────────────────────────────────────────────────
# Defaults come from @plantops/contracts; override only with reason.
# 15 min (Doc 03 §1)
ACCESS_TOKEN_TTL_SECONDS=900
# 7 days (Doc 03 §1)
REFRESH_TOKEN_TTL_SECONDS=604800
# ≤ 300 — the TTL *is* the service-account revocation window (Doc 03 §5)
SERVICE_TOKEN_TTL_SECONDS=300
# 10–30 — concurrent-refresh grace window (Doc 03 §4)
REFRESH_REUSE_GRACE_SECONDS=15
# ≤ 600 — safety net behind cache invalidation (Doc 04 §6)
GRANTS_CACHE_TTL_SECONDS=600

# ── Binding-expiry sweep (Doc 04 §7, Doc 01 §4.5) ──────────────────────────
# The one invalidation cause with no mutation behind it: time passing is not a
# hook, so a timer asks the database what has lapsed and evicts those subjects.
# Not what makes an expired binding stop working — `resolve()` filters on
# `expires_at` directly — but what stops a cache entry written a minute earlier
# from serving the grant until GRANTS_CACHE_TTL_SECONDS evicts it.
#
# 0 disables it, falling back to that TTL. Integration suites set 0 so a timer
# cannot fire mid-run; it is safe precisely because the backstop exists.
EXPIRY_SWEEP_INTERVAL_SECONDS=60
# Rows one pass claims per tenant, so a mass expiry in one client cannot hold
# the sweep open behind every other client's handful.
EXPIRY_SWEEP_BATCH_SIZE=500

# ── Account state & password reset (Doc 03 §7–8) ───────────────────────────
# Consecutive failed logins that lock an account. The lock is administrative:
# it does not lift on its own, and it force-logs-out the account's sessions.
# There is no "off" — raise the number if you truly want no lockout.
LOGIN_MAX_FAILED_ATTEMPTS=5
# ≤ 86400 — how long a reset link stays usable. It is a bearer credential in
# somebody's inbox; the shorter this is, the less a later mailbox compromise
# is worth.
PASSWORD_RESET_TTL_SECONDS=3600

# ── Platform bootstrap (Doc 07 §8) ─────────────────────────────────────────
# Secret for the first platform identity. Minimum 32 characters, supplied
# out-of-band, and rotated immediately after first use. Never logged.
#
# Read by migration 0011 and by nothing else, which means a deployed
# environment needs it for exactly one release — the first — and never again.
# `npm run release:migrate` checks for it up front when that migration is still
# pending, so the first deploy of a new environment fails before it starts
# rather than eight migrations in. Delete it from the release job afterwards;
# see `docs/ops-runbook.md` §6.
PLATFORM_BOOTSTRAP_SECRET=change-me-to-a-32-char-random-string
